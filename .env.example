# Supabase PostgreSQL Connection String
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Direct URL if using Supabase connection pooler for migrations (optional)
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional basic admin password (for simple auth toggle if needed)
# ADMIN_PASSWORD="admin_secret_key"
